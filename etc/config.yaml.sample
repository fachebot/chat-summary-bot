# 代理服务器配置（也可在 Web 登录页/仪表盘「代理」页配置并写回本文件）
Sock5Proxy:
  Enable: true # 是否启用代理
  Type: socks5 # 代理类型: socks5 / http / mtproto，默认 socks5
  Host: 127.0.0.1 # 代理服务器地址
  Port: 1080 # 代理服务器端口
  Username: "" # 代理用户名（可选，socks5/http 认证）
  Password: "" # 代理密码（可选）
  Secret: "" # MTProto 代理 secret（可选）

# 电报App配置
TelegramApp:
  ApiId: 1570912
  ApiHash: 6e5be26cb0623190c048adb6bb066be7

# LLM配置
LLM:
  BaseURL: https://api.openai.com/v1  # 兼容 OpenAI API 的端点
  APIKey: your-api-key-here
  Model: deepseek-v4-flash  # 如 gpt-4o, deepseek-chat, qwen-plus
  MaxTokens: 1000000  # 模型上下文窗口大小；如使用 DeepSeek V4 可按模型规格调整到 1000000
  MaxOutputTokens: 384000  # 单次最大输出 tokens；DeepSeek V4 可按需提高到 384000

# 总结配置
Summary:
  Cron: "0 0 * * *" # cron 表达式，每天0点(UTC时间)执行
  RetentionDays: 7 # 消息保留天数
  RangeDays: 1 # 总结天数，1=仅昨天，7=最近7天
  NotifyMode: private # "private" / "group" / "both"
  NotifyUserIds: # 私聊通知的目标用户ID列表
    - 7779208645
  ChatNotifyModes: # 按群聊单独覆盖通知方式，key=群聊ID，value="private"/"group"/"both"；不配置则使用全局 NotifyMode
    # -1001234567890: group
    # -1009876543210: both
  RetryTimes: 3 # 总结失败重试次数，默认 3
  RetryInterval: 60 # 重试间隔（秒），默认 60
  Whitelist: # 白名单群组ID列表，设置后只保存和总结白名单群组（与黑名单互斥，优先使用白名单）
    # - -1001234567890
  Blacklist: # 黑名单群组ID列表，设置后不保存和总结黑名单群组（白名单为空时生效）
    # - -1001234567890
  AdminUserIds: # 手动触发摘要的白名单用户ID列表，使用 /summary 命令
    # - 7779208645

# 市场指标广播配置
MarketIndicator:
  Enable: true # 是否启用指标广播
  Cron: "0 1 * * *" # cron 表达式，每天 UTC 1点执行（北京时间 9点）
  Whitelist: # 白名单群组ID列表，为空表示所有群组
  Blacklist: # 黑名单群组ID列表

# Web 管理面板配置
Web:
  Enable: false # 是否启用 Web 管理面板
  Port: 8080 # HTTP 端口
  Token: "" # 管理面板认证 Token，留空不认证

# Telegram -> Lark 实时转发配置
LarkForward:
  Enable: false # 是否启用指定 Telegram 用户消息实时转发
  AppID: cli_xxxxxxxxxxxxxxxxx # Lark 自建应用 App ID
  AppSecret: your-app-secret # Lark 自建应用 App Secret
  UrgentUserIDType: open_id # open_id / union_id / user_id
  UrgentUserIDs: # 需要接收私聊告警并执行应用内加急的 Lark 用户 ID 列表
    # - ou_xxxxxxxxxxxxxxxxx
  MonitorTelegramUserIDs: # 需要监控的 Telegram 用户 ID 列表
    # - 123456789
  MonitorTelegramUsernames: # 需要监控的 Telegram 用户名列表，可带 @
    # - target_user
